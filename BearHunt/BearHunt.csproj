<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="StarFederation.Datastar" Version="1.4.0" />
    <PackageReference Include="StarFederation.Datastar.FSharp" Version="1.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <Target Name="ProcessCss" BeforeTargets="BeforeBuild">
    <Exec Command="npx lightningcss --bundle --minify --nesting wwwroot/styles.src.css -o wwwroot/styles.css"
          WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
