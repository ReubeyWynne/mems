<tr id="member-@E(Member.Username)">
    <td>@E(Member.Username)</td>
    <td class="troops-col">@FmtK(Member.Infantry) / @FmtK(Member.Cavalry) / @FmtK(Member.Archers) <span class="formation">(@Formation)</span></td>
    <td><span class="hero-col">@E(Member.RallyLeadHero)</span> <span class="hero-lv">(Lv@(Member.WidgetLevel))</span></td>
    <td class="march-col">@FmtK(Member.RallySize)</td>
    <td class="march-col">@FmtK(Member.SoloMarchSize)</td>
</tr>

@code {
    [Parameter, EditorRequired] public Member Member { get; set; } = null!;

    string Formation
    {
        get
        {
            var total = Member.Infantry + Member.Cavalry + Member.Archers;
            if (total == 0) return "\u2014";
            return $"{Member.Infantry * 100 / total}/{Member.Cavalry * 100 / total}/{Member.Archers * 100 / total}";
        }
    }
}
