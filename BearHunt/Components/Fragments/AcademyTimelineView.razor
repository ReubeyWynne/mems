@using System.Globalization
@* One shared-axis timeline fragment: per-minute fire density strip,
   parametric staggered lanes, readouts, roster. (FFA reference removed for
   now — staggered only.) Rendered by the SSR page AND the
   /api/academy/timeline Datastar endpoint via RazorRenderer so the two can
   never drift apart. *@
@if (Plan is null)
{
    return;
}

<div id="timeline" class="tl" style="--axis:@F(AcademyTimeline.EventLength);--lanes:@(Plan.GroupCount)">
    @* One ruler for both plans. *@
    <div class="tl-ticks" aria-hidden="true">
        @foreach (var t in MajorTicks(AcademyTimeline.EventLength))
        {
            <span class="tl-tick tl-tick-major" style="--at:@F(t)"><span class="tl-tick-label">@T(t)</span></span>
        }
        @foreach (var t in MinorTicks(AcademyTimeline.EventLength))
        {
            <span class="tl-tick tl-tick-minor" style="--at:@F(t)"></span>
        }
    </div>

    @* Last-call zone. *@
    <div class="tl-zone" style="@RangeStyle(Plan.LastCall, AcademyTimeline.EventLength)"><span>last call @T(Plan.LastCall)</span></div>

    @* Lane headers. *@
    <div class="tl-heads">
        @if (Plan.EmptyState is null)
        {
            @foreach (var lane in Plan.Lanes)
            {
                <div class="tl-head" data-tip="@HeadTip(lane)"><span>@E(lane.Name)</span><span class="tl-head-count">@I(lane.Fires.Count)&times;</span></div>
            }
            if (Plan.GroupCount > MaxVisibleLanes)
            {
                int pooled = Plan.Leads - Plan.Lanes.Take(MaxVisibleLanes).Sum(l => l.Leads.Count);
                if (pooled > 0)
                {
                    <div class="tl-head tl-pooled"><span>&hellip;+@I(pooled) more leads</span></div>
                }
            }
        }
    </div>

    @* Lanes: one per launch group. *@
    <div class="tl-lanes">
        @if (Plan.EmptyState is null)
        {
            @for (int g = 0; g < Plan.Lanes.Count; g++)
            {
                var lane = Plan.Lanes[g];
                <div class="tl-lane" style="--lane:@(g)">
                    @foreach (var s in lane.Segs)
                    {
                        <div class="tl-seg @SegClass(s)" style="@SegStyle(s)" data-tip="@SegTip(lane, s)">
                            @if (s.FillAt is { } fill)
                            {
                                <div class="tl-empty-window" style="--from:@F(s.From);--fill:@F(fill)"></div>
                                <div class="tl-fill-window" style="--fill:@F(fill);--to:@F(s.To)"></div>
                            }
                        </div>
                    }
                    @foreach (var f in lane.Fires)
                    {
                        <div class="tl-fire" style="--at:@F(f)" data-tip="@FireTip(f)"></div>
                    }
                    @foreach (var s in lane.Segs.Where(s => s.Kind == AcademyTimeline.SegKind.March))
                    {
                        <div class="tl-seg-label @(s.Reload ? "reload" : s.FillAt is null ? "first" : "wait")" style="@SegStyle(s)">
                            @if (s.FillAt is { } fill)
                            {
                                <span class="line1"><span class="tl-label-full">@E(lane.Name) &middot; empty</span><span class="tl-label-short">empty</span></span>
                                <span class="line2">fills @T(fill) &middot; fires @T(s.To)</span>
                            }
                            else if (s.Reload)
                            {
                                <span class="line1">relaunch</span>
                                <span class="line2">fires @T(s.To)</span>
                            }
                            else
                            {
                                <span class="line1"><span class="tl-label-full">@E(lane.Name) &middot; launch @T(s.From)</span><span class="tl-label-short">launch @T(s.From)</span></span>
                                <span class="line2">fires @T(s.To)</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    @* Per-minute fire density strip. *@
    @if (Plan.EmptyState is null)
    {
        <div class="tl-density">
            @{
                int stagMax = Plan.Density.Count > 0 ? Plan.Density.Max(c => c.StagFires) : 0;
            }
            @foreach (var c in Plan.Density)
            {
                double hStag = stagMax > 0 ? (double)c.StagFires / stagMax : 0;
                string label = $"{T(c.Minute)} — {I(c.StagFires)} fires";
                <div class="tl-density-cell" aria-label="@label">
                    <div class="tl-density-bar-stag" style="--h:@H(hStag)"></div>
                </div>
            }
        </div>

        var r = Plan.Readouts;
        <div class="tl-readouts">
            <span class="tl-readout" data-tip="Average staggered rallies firing per minute: total fires &divide; @F(AcademyTimeline.EventLength - AcademyTimeline.FireDelay) minutes of firing window.">@F(r.FiresPerMinuteMean) fires/min mean</span>
            <span class="tl-readout" data-tip="Busiest minute — most staggered rallies firing in any single minute.">@I(r.MaxFiresPerMinute) fires/min max</span>
            <span class="tl-readout" data-tip="Total rally fire events this event — every lead's rally fires once per round.">@I(r.RalliesFiredStag) rallies fire</span>
            <span class="tl-readout" data-tip="Longest gap between consecutive fires, first fire to last fire.">@T(r.LongestSilence) longest silence</span>
            <span class="tl-readout" data-tip="Every participant sends their Q marches each round, one rally per march: @I(r.Rounds) rounds &times; Q &mdash; minus the marches that overflow round 1 and join a round late. @I(r.RalliesJoined) rally joins across all participants.">@F(r.RalliesJoinedPerParticipant) joins/participant</span>
            <span class="tl-readout" data-tip="Average minutes each participant's troops sit parked waiting for a free slot.">@F(r.MinutesParkedPerParticipant) min parked/participant</span>
            <span class="tl-readout" data-tip="First-wave joiner slots &mdash; (leads in groups 1+2) &times; 14 &mdash; vs marches to send (participants &times; queues). Groups 3+ launch empty and fill from round-1 returnees.">R1: @I(r.Capacity) slots vs @I(r.Demand) marches — @r.Verdict</span>
            <span class="tl-readout" data-tip="Share of minutes @T(AcademyTimeline.FireDelay)–@T(AcademyTimeline.EventLength) with at least one staggered fire.">@I((int)Math.Round(r.CoveragePct * 100))% coverage</span>
            <span class="tl-readout" data-tip="The plan's first rally fires at @T(r.FirstFire) — the fixed 5-minute run, no matter what.">first fire @T(r.FirstFire)</span>
        </div>

        @if (r.Overflow)
        {
            <div class="tl-overflow" data-tip="The first wave can't fit in groups 1&ndash;2 &mdash; these marches wait a round and launch with the returnees.">Overflow — @Marches(r.OverflowMarches) beyond first-wave capacity</div>
        }
    }

    @* Trap anchor chip (schedule context, shown even in the empty state). *@
    @if (Plan.TrapAnchor is { } trap)
    {
        <span class="tl-trap" data-tip="Prefilled from the real schedule">trap at @(trap.ToString("HH:mm", CultureInfo.InvariantCulture))</span>
    }

    @* Empty-state overlay (ticks + zone still render; no lanes/strip/readouts). *@
    @if (Plan.EmptyState is { } msg)
    {
        <div class="tl-empty">@E(msg)</div>
    }

      </div>

@code {
    /// <summary>The computed plan (see <see cref="BearHunt.AcademyTimeline.Compute"/>).</summary>
    [Parameter] public AcademyTimeline.Plan Plan { get; set; } = null!;

    const int MaxVisibleLanes = 8; // pool "+N more leads" past this many group lanes

    // ─── Geometry + formatting helpers ────────────────────────────────────
    // Positions are minutes/axis percentages, rendered as CSS custom
    // properties so one DOM tree serves both the horizontal (desktop) and
    // vertical (mobile) layouts via media queries.

    /// <summary>Minutes → "0.0" (CSS custom-property value).</summary>
    static string F(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);

    /// <summary>Ratio → "0.00" (density bar heights).</summary>
    static string H(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);

    /// <summary>Minutes → "m:ss" clock label.</summary>
    static string T(double min) =>
        $"{(int)min}:{Math.Round(min % 1 * 60).ToString("00", CultureInfo.InvariantCulture)}";

    static string I(int n) => n.ToString(CultureInfo.InvariantCulture);

    /// <summary>"1 march" / "N marches" (singular-aware).</summary>
    static string Marches(int n) => n == 1 ? "1 march" : $"{I(n)} marches";

    static string Ordinal(int n) => n switch { 1 => "1st", 2 => "2nd", 3 => "3rd", _ => $"{n}th" };

    /// <summary>Group header tooltip: leads, rounds, fires — plus the travel
    /// boundary for one more round, for the travel-limited late groups
    /// (group 4 needs travel under 30s for a 5th; group 5 needs under 15s,
    /// which the game's 30s travel can never meet).</summary>
    static string HeadTip(AcademyTimeline.Lane lane)
    {
        int n = lane.Leads.Count, rounds = lane.Rounds, fires = lane.Fires.Count;
        string tip = $"{lane.Name} — {I(n)} leads · {I(rounds)} rounds · {I(fires)} fires";
        if (lane.Index == 3) tip += $" · fast group ({I(AcademyTimeline.Group4TravelSeconds)}s travel)";
        if (rounds >= 5) return tip;
        // One more round fits iff g + rounds × (5 + travel) < last call for EVERY lead.
        double needMin = (AcademyTimeline.EventLength - AcademyTimeline.FireDelay - lane.Index) / rounds - AcademyTimeline.FireDelay;
        int needSec = (int)Math.Ceiling(needMin * 60);
        return needSec > 0
            ? tip + $" — a {Ordinal(rounds + 1)} round needs every lead's travel under {I(needSec)}s"
            : tip + $" — a {Ordinal(rounds + 1)} round can't fit";
    }

    static string SegStyle(AcademyTimeline.Seg s) => $"--from:{F(s.From)};--to:{F(s.To)}";
    static string RangeStyle(double from, double to) => $"--from:{F(from)};--to:{F(to)}";
    static string SegClass(AcademyTimeline.Seg s) => s.Kind switch
    {
        AcademyTimeline.SegKind.March => "seg-march",
        AcademyTimeline.SegKind.Reload => "seg-reload",
        AcademyTimeline.SegKind.Launch => "seg-launch",
        AcademyTimeline.SegKind.Fight => "seg-fight",
        _ => "seg-join",
    };
    static string SegTip(AcademyTimeline.Lane lane, AcademyTimeline.Seg s) => s.Kind switch
    {
        AcademyTimeline.SegKind.March when s.FillAt is { } fill =>
            $"{lane.Name} — {lane.Leads.Count} leads launch {T(s.From)} empty; returnees from groups 1–2 fill the rally at {T(fill)} · fires at {T(s.To)}",
        AcademyTimeline.SegKind.March => $"{lane.Name} — {lane.Leads.Count} leads marching {T(s.From)}–{T(s.To)} · fires at {T(s.To)}",
        AcademyTimeline.SegKind.Reload => $"{lane.Name} relaunch — {lane.Leads.Count} leads marching {T(s.From)}–{T(s.To)} · fires at {T(s.To)}",
        _ => "Fight + travel home (~30s)",
    };
    static string FireTip(double f) => $"Rally fires at {T(f)}";

    /// <summary>Major ticks every 5 minutes, including the axis end.</summary>
    static IEnumerable<double> MajorTicks(double length)
    {
        for (double t = 0; t <= length; t += 5) yield return t;
    }

    /// <summary>Minor ticks each minute, skipping the majors.</summary>
    static IEnumerable<double> MinorTicks(double length)
    {
        for (double t = 1; t < length; t += 1) if (t % 5 != 0) yield return t;
    }
}
