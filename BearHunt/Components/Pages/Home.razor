@page "/"
@inject AppDbContext Db

<div class="homepage">
    <div class="homepage-hero">
        <h1 class="homepage-title">
            Welcome to MadNess
        </h1>
        @if (_splashText is not null)
        {
            <span class="splash-text">@_splashText</span>
        }
    </div>
    <p class="homepage-subtitle">Bear Hunt Alliance Tool</p>

    <div class="grid-fill hub-cards">
        <a href="/bear-hunt/schedule" class="card hub-card">
            <h3>Bear Hunt</h3>
            <p>Next bear day countdown and trap signups</p>
        </a>
        <a href="/bear-hunt/profile" class="card hub-card">
            <h3>Profile</h3>
            <p>Set your troop counts, heroes, and march sizes</p>
        </a>
        <a href="/bear-hunt/roster" class="card hub-card">
            <h3>Roster</h3>
            <p>View all alliance members and their loadouts</p>
        </a>
        <a href="/bear-hunt/schedule" class="card hub-card">
            <h3>Schedule</h3>
            <p>Next bear day countdown and trap signups</p>
        </a>
    </div>
</div>

@code {
    private string? _splashText;

    protected override async Task OnInitializedAsync()
    {
        if (Random.Shared.Next(3) != 0) return;

        var count = await Db.Jokes.CountAsync();
        if (count == 0) return;

        var skip = Random.Shared.Next(count);
        var joke = await Db.Jokes.OrderBy(j => j.Id).Skip(skip).FirstAsync();
        _splashText = joke.Text;
    }
}
