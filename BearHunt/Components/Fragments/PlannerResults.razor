@* Admin planner output: both trap plans, or the empty state when no cycle
   is configured. The root element carries the id the SSE patch targets. *@
<div id="planner-results">
    @if (Plan1 is null || Plan2 is null)
    {
        <p>No cycle configured yet.</p>
    }
    else
    {
        <div class="planner-stack">
            <PlannerTrapSection Plan="@Plan1" />
            <PlannerTrapSection Plan="@Plan2" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TrapPlan? Plan1 { get; set; }
    [Parameter, EditorRequired] public TrapPlan? Plan2 { get; set; }
}
