@page "/bear-hunt/roster"
@inject AppDbContext Db
@inject NavigationManager Nav

<h1>Roster</h1>

<div class="roster-card">
    <div class="roster-header">
        <span class="roster-label">ALLIANCE MEMBERS</span>
    </div>
    <div class="roster-body" data-init="@@get('/api/roster')">
        <table class="roster-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Troops (I/C/A)</th>
                    <th>Rally Lead</th>
                    <th>Rally Size</th>
                    <th>Solo March</th>
                </tr>
            </thead>
            <tbody id="roster-rows">
                <tr><td colspan="5">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>
