@page "/bear-hunt/roster"
<PageTitle>Roster &middot; Bear Hunt</PageTitle>

<h1>Roster</h1>

<div class="card card--rounded roster-card">
    <div class="banner roster-header">
        <span class="roster-label">ALLIANCE MEMBERS</span>
    </div>
    <div class="roster-body" data-init="@@get('/api/roster')">
        <table class="roster-table">
            <thead>
                <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Troops (I/C/A)</th>
                    <th scope="col">Rally Lead</th>
                    <th scope="col">Rally Size</th>
                    <th scope="col">Solo March</th>
                </tr>
            </thead>
            <tbody id="roster-rows">
                <tr><td colspan="5">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>
