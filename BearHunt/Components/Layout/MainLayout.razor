<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>MadNess &middot; Bear Hunt</title>
    <style>body{visibility:hidden}</style>
    <noscript><style>body{visibility:visible}</style></noscript>
    <link rel="stylesheet" href="/styles.css" onload="document.body.style.visibility='visible'" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='12' fill='%231a1a2e'/><text x='32' y='46' text-anchor='middle' font-size='36' font-weight='900' fill='%23f0c040' font-family='system-ui,sans-serif'>MAD</text></svg>" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <nav aria-label="Main">
        <a href="/" class="nav-brand">
            <span class="nav-brand-wordmark">MAD</span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-hamburger" aria-label="Menu">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="4" y1="6" x2="20" y2="6"/>
                <line x1="4" y1="12" x2="20" y2="12"/>
                <line x1="4" y1="18" x2="20" y2="18"/>
            </svg>
        </label>
        <div class="nav-links">
        <a href="/" class="@NavClass("/")" aria-current="@AriaCurrent("/")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Home
        </a>
        <a href="/bear-hunt/profile" class="@NavClass("/bear-hunt/profile")" aria-current="@AriaCurrent("/bear-hunt/profile")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            Profile
        </a>
        <a href="/bear-hunt/roster" class="@NavClass("/bear-hunt/roster")" aria-current="@AriaCurrent("/bear-hunt/roster")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Roster
        </a>
        <a href="/bear-hunt/schedule" class="@NavClass("/bear-hunt/schedule")" aria-current="@AriaCurrent("/bear-hunt/schedule")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Schedule
        </a>
        <a href="/bear-hunt/academy" class="@NavClass("/bear-hunt/academy")" aria-current="@AriaCurrent("/bear-hunt/academy")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            Academy
        </a>
        <a href="/bear-hunt/admin" class="@NavClass("/bear-hunt/admin") nav-right" aria-current="@AriaCurrent("/bear-hunt/admin")">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            Admin
        </a>
        </div>
    </nav>
    <main id="main-content">
        @Body
    </main>
    <script src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.2/bundles/datastar.js" type="module"></script>
    <script src="/intl-time.js" type="module"></script>
    <script src="/tooltip.js" type="module"></script>
</body>
</html>

@code {
    [Parameter] public RenderFragment? Body { get; set; }

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    private string NavClass(string path)
    {
        var uriPath = new Uri(Nav.Uri).AbsolutePath;
        bool active = path == "/"
            ? uriPath == "/"
            : uriPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        return active ? "nav-link active" : "nav-link";
    }

    private string? AriaCurrent(string path)
    {
        var uriPath = new Uri(Nav.Uri).AbsolutePath;
        bool active = path == "/"
            ? uriPath == "/"
            : uriPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        return active ? "page" : null;
    }
}
