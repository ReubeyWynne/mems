<div id="trap-roster-@Trap" class="trap-roster trap-@Trap">
    <div class="trap-header">
        <span class="trap-label">Trap @Trap</span>
        <time class="trap-time" data-intl-time="time" datetime="@TrapDateTime.ToString("yyyy-MM-dd")T@(TrapTime.ToString("HH:mm")):00Z">@TrapTime.ToString("HH:mm") UTC</time>
        <span class="trap-count">@Prefs.Count</span>
    </div>
    @if (Prefs.Count == 0)
    {
        <p class="trap-empty">No signups yet.</p>
    }
    else
    {
        <table class="trap-table">
            <thead>
                <tr>
                    <th scope="col">Player</th>
                    <th scope="col">I/C/A</th>
                    <th scope="col">March</th>
                    <th scope="col">Hero</th>
                    @if (IsAdmin)
                    {
                        <th scope="col">Wave</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Prefs.OrderBy(p => p.Username))
                {
                    Members.TryGetValue(p.Username, out var m);
                    <TrapRosterRow Preference="@p" Member="@m" IsAdmin="@IsAdmin" />
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Trap { get; set; } = null!;
    [Parameter, EditorRequired] public TimeOnly TrapTime { get; set; }
    [Parameter, EditorRequired] public DateTime NextDate { get; set; }
    [Parameter, EditorRequired] public List<Preference> Prefs { get; set; } = null!;
    [Parameter, EditorRequired] public Dictionary<string, Member> Members { get; set; } = null!;
    [Parameter] public bool IsAdmin { get; set; }

    DateTime TrapDateTime => NextDate.Date.Add(TrapTime.ToTimeSpan());
}
