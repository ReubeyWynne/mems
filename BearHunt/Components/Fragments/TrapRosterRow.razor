<tr id="pref-@Preference.Id" class="trap-row@(Preference.IsRallyLead ? " rally-lead" : "")">
    <td>
        @E(Preference.Username)
        @if (Preference.IsRallyLead)
        {
            <span class="rally-badge" title="Rally Lead">&#9733;</span>
        }
    </td>
    <td class="troops-col">
        @if (Member is { } m && m.Infantry + m.Cavalry + m.Archers > 0)
        {
            var total = m.Infantry + m.Cavalry + m.Archers;
            @($"{FmtK(m.Infantry)}/{FmtK(m.Cavalry)}/{FmtK(m.Archers)}") <span class="formation">@($"({m.Infantry * 100 / total}/{m.Cavalry * 100 / total}/{m.Archers * 100 / total})")</span>
        }
        else
        {
            <text>&mdash;</text>
        }
    </td>
    <td class="march-col">
        @if (Member is { RallySize: > 0 } rs)
        {
            @FmtK(rs.RallySize)
        }
        else if (Member is { SoloMarchSize: > 0 } sm)
        {
            @($"{FmtK(sm.SoloMarchSize)}s")
        }
        else
        {
            <text>&mdash;</text>
        }
    </td>
    <td class="hero-col">
        @if (Member is { RallyLeadHero: not null and not "" } h)
        {
            @E(h.RallyLeadHero) <span class="hero-lv">Lv@(h.WidgetLevel)</span>
        }
        else
        {
            <text>&mdash;</text>
        }
    </td>
    @if (IsAdmin)
    {
        <td class="wave-col">
            <div class="admin-controls">
                <form data-on:submit="@($"@post('/api/admin/assign-wave/{Preference.Id}', {{contentType: 'form'}})")" action="#">
                    <label><span class="sr-only">Wave</span><select name="wave" class="wave-select" onchange="this.form.requestSubmit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Preference.Wave))">--</option>
                        <option value="0" selected="@(Preference.Wave == "0")">W0</option>
                        <option value="1" selected="@(Preference.Wave == "1")">W1</option>
                        <option value="2" selected="@(Preference.Wave == "2")">W2</option>
                        <option value="3" selected="@(Preference.Wave == "3")">W3</option>
                        <option value="4" selected="@(Preference.Wave == "4")">W4</option>
                        <option value="reserves" selected="@(Preference.Wave == "reserves")">Reserves</option>
                    </select></label>
                </form>
                <button data-on:click="@($"@post('/api/admin/toggle-rally-lead/{Preference.Id}')")"
                        class="rl-toggle@(Preference.IsRallyLead ? " active" : "")"
                        title="Toggle Rally Lead">RL</button>
            </div>
        </td>
    }
</tr>

@code {
    [Parameter, EditorRequired] public Preference Preference { get; set; } = null!;
    [Parameter] public Member? Member { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
}
