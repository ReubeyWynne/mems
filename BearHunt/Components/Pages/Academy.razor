@page "/bear-hunt/academy"
@using System.Globalization
@inject AppDbContext Db
@inject IHttpContextAccessor HttpContextAccessor
<PageTitle>Academy &middot; Bear Hunt</PageTitle>

<h1>&#127891; Bear Academy</h1>
<p class="academy-intro">Three things make a big difference in Bear Hunt &mdash; and none of them need a spreadsheet. Each one takes a minute.</p>

<!-- ══════════════ Bear Strategies ══════════════ -->
<section id="strategies" class="lesson lesson-section">
    <h2>&#127993;&#65039; Bear Strategies</h2>
    <p class="academy-intro">A bear rally has a <strong>fixed 5-minute run</strong>: it fires exactly 5 minutes after it launches, no matter what. So the whole game is <em>when</em> your rallies launch. Same 30-minute event, same clock &mdash; the first 11 minutes tell you everything. Here are the two ways alliances play it.</p>

    <div class="scenario">
        <div class="tl-shell">
            <div class="tl-legend">
                <span class="tl-legend-item"><span class="tl-swatch sw-march"></span>Marching</span>
                <span class="tl-legend-item"><span class="tl-swatch sw-reload"></span>Relaunch</span>
                <span class="tl-legend-item"><span class="tl-swatch sw-fight"></span>Fight + travel</span>
            </div>

            <form method="get" action="" class="tl-controls" data-signals='{ "leads": @_inputs.Leads, "participants": @_inputs.Participants, "tlq": @_inputs.Q, "spread": @_inputs.SpreadSeconds, "g5": @(_inputs.UseGroup5 ? "true" : "false"), "source": "@_source" }'
                  data-on:submit="@@get('/api/academy/timeline', {contentType: 'form'})">
                <div class="form-row">
                    <div class="form-group">
                        <label>Rally leads
                            <input type="number" name="leads" min="0" max="100" data-bind:leads data-attr:disabled="$source === 'prefill'" data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})" />
                        </label>
                    </div>
                    <div class="form-group">
                        <label>Participants (incl. leads)
                            <input type="number" name="participants" min="1" max="300" data-bind:participants data-attr:disabled="$source === 'prefill'" data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})" />
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="q-slider">Q — simultaneous marches per player
                            <span data-text="$tlq">@_inputs.Q</span>
                            <input type="range" name="q" min="1" max="6" data-bind:tlq data-attr:disabled="$source === 'prefill'" data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})" />
                        </label>
                    </div>
                    <div class="form-group">
                        <label class="q-slider">Spread — seconds between a group's lead launches
                            <span data-text="$spread">@_inputs.SpreadSeconds</span>
                            <input type="range" name="spread" min="0" max="24" step="1" data-bind:spread data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})" />
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Source
                            <select name="source" data-bind:source data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})">
                                <option value="custom">Custom</option>
                                <option value="prefill">Real schedule</option>
                            </select>
                        </label>
                    </div>
                    <div class="form-group">
                        <label class="tl-check"><input type="checkbox" data-bind:g5 checked="@(_inputs.UseGroup5)" data-on:change="@@get('/api/academy/timeline', {contentType: 'form'})" /> 5th group</label>
                        <input type="hidden" name="g5" data-bind:g5 value="@(_inputs.UseGroup5 ? "true" : "false")" />
                        <p class="tl-hint">optional &mdash; excess leads only</p>
                    </div>
                </div>
            </form>

            <AcademyTimelineView Plan="_plan" />
        </div>
        <p class="scenario-caption">
            <br/>
            <strong>Staggered:</strong> The plan above is generated from your numbers &mdash; rally leads, participants, queues, spread. Leads split into launch groups, strongest first, and the first two groups carry the entire first wave, so they must fit everyone: <em>(leads in groups 1&ndash;2) &times; 14 joiner slots &ge; participants &times; Q</em>. The later groups launch hollow (hatched) and fill from the round-1 returnees around 5:30 (yellow join window); after that every group relaunches the moment its troops return, so rallies fire almost every minute from 5:00 on. Group 4's leads are the fast group &mdash; 20s fight + travel vs the 30s everyone else rides &mdash; which is exactly what buys them a 5th round (launch 24:20, fires 29:20). Group 5 can never fit a 5th (it would need under 15s travel), so it's optional: untick it unless you have an excess of strong leads. The bars in the density strip are those fires; the chips below keep score &mdash; fires per minute, longest silence, coverage, minutes parked. Drag the controls and watch the plan rebuild honestly: too few leads in the first two groups overflows the first wave, and a single lead widens the gaps to minutes.
        </p>
    </div>

    <div class="lesson-fact">  Same joiners, same troops. Staggering keeps fresh rallies firing every minute from 5:00 onward &mdash; if the first two groups can hold everyone's marches.</div>
</section>

<!-- ══════════════ Split Your Troops ══════════════ -->
<section id="split" class="lesson lesson-section">
    <h2>&#9986;&#65039; Split Your Troops</h2>
    <p class="academy-intro">One big march leaves damage on the table. Double the troops only adds about <strong>40%</strong> more damage &mdash; every extra troop hits a little softer than the last. Spread those same troops across <strong>simultaneous</strong> marches instead, and you deal more damage without spending anything extra. <strong>Use every march slot, every wave.</strong></p>

    <div class="lesson diminish">
        <h3>The bigger the rally, the less each troop adds</h3>
        <figure class="diminish-chart">
            <svg viewBox="0 0 380 170" role="img" aria-label="Damage grows with troop count but slows down: doubling troops adds only about 40 percent damage. The dashed line shows what one-for-one growth would look like.">
                <line class="diminish-linear" x1="34" y1="99.5" x2="368" y2="-328" />
                <!-- axes -->
                <line class="diminish-axis" x1="34" y1="14" x2="34" y2="160" />
                <line class="diminish-axis" x1="34" y1="160" x2="368" y2="160" />
                <polyline class="diminish-curve" points="34,99.5 56.5,87.7 78.75,78.6 101,71 145.5,58.2 190,47.4 279,29.3 368,14" />
                <circle class="diminish-dot" cx="34" cy="99.5" r="3.5" />
                <circle class="diminish-dot" cx="56.5" cy="87.7" r="3.5" />
                <circle class="diminish-dot" cx="101" cy="71" r="3.5" />
                <circle class="diminish-dot" cx="190" cy="47.4" r="3.5" />
                <circle class="diminish-dot" cx="368" cy="14" r="3.5" />
                <text class="diminish-dmg" x="34" y="115.5">1.0</text>
                <text class="diminish-dmg" x="56.5" y="103.7">1.4</text>
                <text class="diminish-dmg" x="101" y="87">2.0</text>
                <text class="diminish-dmg" x="190" y="63.4">2.8</text>
                <text class="diminish-dmg" x="368" y="30">4.0</text>
                <text class="diminish-troop" x="34" y="160">1&times;</text>
                <text class="diminish-troop" x="56.5" y="160">2&times;</text>
                <text class="diminish-troop" x="101" y="160">4&times;</text>
                <text class="diminish-troop" x="190" y="160">8&times;</text>
                <text class="diminish-troop" x="368" y="160">16&times;</text>
            </svg>
            <figcaption>Troops &rarr; &middot; doubling troops adds only ~40% damage &middot; dashed line = 1:1 growth</figcaption>
        </figure>
        <p class="scenario-caption">The first 10k troops hit hardest. The next 20k add only about a third as much per troop. The 40k after that? Less than a quarter. Every troop you send is worth a little less than the one before it &mdash; so the fastest way to more damage isn't a bigger march, it's more marches.</p>
    </div>

    <div class="split-slider" data-signals='{ "q": @_q }'>
        <h3>Same troops, more simultaneous rallies</h3>
        <label class="q-slider">
            Simultaneous rallies
            <input type="range" id="q-slider" min="1" max="6" value="@_q" data-bind:q />
            <span id="q-value" data-text="$q">@_q</span>
        </label>
        <div class="split-live">That's <strong><span id="split-ratio" data-computed:ratio="Math.sqrt($q).toFixed(1)" data-text="$ratio">@_gainRatio.ToString("0.0", CultureInfo.InvariantCulture)</span>&times;</strong> the damage of one big march &mdash; same troops, nothing extra spent.</div>
        <p class="split-note">6 is the most simultaneous rallies any player can field &mdash; aim for all 6, every wave.</p>
    </div>

    <div class="lesson-box">
        <h3>Why everyone stacks on the whale &mdash; and why it hurts</h3>
        <p>It's tempting to stack every march on the strongest player &mdash; their stats are better, so their rallies hit harder. But a rally has limited slots, and the same diminishing returns apply: more troops in one rally adds less and less. Most just <strong>queue up, parked 4+ minutes between hits</strong> &mdash; the same dead time as the free-for-all. The whale's stats only help the few who fit inside. Spread out: more rallies beats one big one, every time.</p>
    </div>

    <div class="lesson-box">
        <h3>Don't hog the rally</h3>
        <p>A 900k rally with 15 slots means <strong>60k per player</strong>. One player stuffing in 200k squeezes out ~3 others &mdash; and the room loses more than that one player gains. Spread out; everyone earns more.</p>
    </div>

    <div class="lesson-box">
        <h3>Keep moving</h3>
        <p>Once waves are staggered, a rally fires roughly <strong>every minute</strong>. Troops parked in a rally that already fired are missing the next one &mdash; every missed fire is damage you're not earning.</p>
    </div>

    <div class="lesson-fact">Same troops, same leaders: <strong>6 simultaneous rallies deal ~2.4&times; the damage of one big march</strong> &mdash; and keep everyone's troops moving instead of parked 4+ minutes.</div>
</section>

<!-- ══════════════ Your Formation ══════════════ -->
<section id="formation" class="lesson lesson-section">
    <h2>&#9876;&#65039; Your Formation</h2>
    <p class="academy-intro">Every leader likes a specific troop mix &mdash; usually <strong>heavy on archers</strong>, because archers hit hardest per troop. Match it and your damage jumps. Pick a leader and plug in your numbers:</p>

    <form method="get" action="" id="formation-form" class="lesson lesson-form"
          data-on:submit="@@get('/api/academy/formation', {contentType: 'form'})">
        <div class="form-row">
            <div class="form-group">
                <label>Leader<select name="leader" data-bind:leader>
                    <option value="custom" selected="@(_leader == "custom")">Custom stats</option>
                    @foreach (var l in _leaders)
                    {
                        <option value="@l.Username" selected="@(_leader == l.Username)" title="Strength = how hard rallies led by this player hit">@E(l.Username) (strength @l.K.ToString("0", CultureInfo.InvariantCulture))</option>
                    }
                </select></label>
                <p class="section-hint">Strength is how hard this leader's rallies hit &mdash; higher is better. Choose <strong>Custom stats</strong> to enter your own numbers.</p>
            </div>
        </div>

        <details id="custom-stats" class="section-hint" open="@(_leader == "custom")" data-attr:open="$leader === 'custom'">
            <summary>Custom stats &mdash; use your own numbers</summary>
            <div class="form-row">
                <div class="form-group">
                    <label>Infantry Atk %<input type="number" name="infAtk" value="@_infAtk" placeholder="250" /></label>
                </div>
                <div class="form-group">
                    <label>Infantry Let %<input type="number" name="infLet" value="@_infLet" placeholder="163" /></label>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Cavalry Atk %<input type="number" name="cavAtk" value="@_cavAtk" placeholder="250" /></label>
                </div>
                <div class="form-group">
                    <label>Cavalry Let %<input type="number" name="cavLet" value="@_cavLet" placeholder="163" /></label>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Archer Atk %<input type="number" name="arcAtk" value="@_arcAtk" placeholder="250" /></label>
                </div>
                <div class="form-group">
                    <label>Archer Let %<input type="number" name="arcLet" value="@_arcLet" placeholder="163" /></label>
                </div>
            </div>
        </details>

        <div class="form-row">
            <div class="form-group">
                <label>Infantry pool<input type="number" name="inf" value="@_inf" placeholder="600000" /></label>
            </div>
            <div class="form-group">
                <label>Cavalry pool<input type="number" name="cav" value="@_cav" placeholder="400000" /></label>
            </div>
            <div class="form-group">
                <label>Archer pool<input type="number" name="arc" value="@_arc" placeholder="100000" /></label>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Q (simultaneous rallies)<input type="number" name="q" value="@_q" min="1" max="6" /></label>
            </div>
            <div class="form-group">
                <label>Per-march cap (0 = uncapped)<input type="number" name="cap" value="@_cap" placeholder="25000" /></label>
            </div>
        </div>
        <button type="submit" class="btn--primary">Compute</button>
    </form>

    <FormationOutput Result="_formation" />
</section>

@code {
    sealed record LeaderPick(string Username, double K);

    // formation
    private readonly List<LeaderPick> _leaders = new();
    private string _leader = "custom";
    private int _inf = 600000, _cav = 400000, _arc = 100000, _q = 6, _cap = 25000;
    private int? _infAtk, _infLet, _cavAtk, _cavLet, _arcAtk, _arcLet;
    private AcademyFormation.Result _formation = null!;

    // split (motivation only, no per-player numbers): Q simultaneous rallies, √ rule
    private double _gainRatio;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        var username = ctx.Request.Cookies.TryGetValue("kh_username", out var u) ? u : "";
        var viewer = !string.IsNullOrEmpty(username) ? await Db.Members.FindAsync(username) : null;

        // leader options: members with complete stats, ranked by K
        var members = await Db.Members.ToListAsync();

        // timeline: shared engine plan from the same controls the page seeds
        var cycle = await Db.Cycles.FindAsync(1);
        var prefs = await Db.Preferences.ToListAsync();
        _inputs = AcademyTimeline.Parse(ctx.Request.Query, cycle, members, prefs);
        _plan = AcademyTimeline.Compute(_inputs);
        _source = ctx.Request.Query["source"].FirstOrDefault() == "prefill" ? "prefill" : "custom";
        foreach (var m in members.Where(CompleteStats))
        {
            var lInf = DamageCalc.AttackFactor(m.InfantryAtkPct, m.InfantryLethalityPct);
            var lCav = DamageCalc.AttackFactor(m.CavalryAtkPct, m.CavalryLethalityPct);
            var lArc = DamageCalc.AttackFactor(m.ArcherAtkPct, m.ArcherLethalityPct);
            _leaders.Add(new LeaderPick(m.Username, DamageCalc.LeaderQuality(lInf, lCav, lArc)));
        }
        _leaders.Sort((a, b) => b.K.CompareTo(a.K));

        var inputs = AcademyFormation.Parse(ctx.Request.Query, viewer);
        _leader = inputs.Leader;
        _infAtk = inputs.InfAtk; _infLet = inputs.InfLet;
        _cavAtk = inputs.CavAtk; _cavLet = inputs.CavLet;
        _arcAtk = inputs.ArcAtk; _arcLet = inputs.ArcLet;
        _inf = inputs.Inf; _cav = inputs.Cav; _arc = inputs.Arc;
        _q = inputs.Q; _cap = inputs.Cap;

        // split motivation: Q equal simultaneous rallies deal √Q × one big march
        _gainRatio = Math.Sqrt(_q);

        _formation = AcademyFormation.Compute(inputs, members);
    }

    static bool CompleteStats(Member m) =>
        m.InfantryAtkPct.HasValue && m.InfantryLethalityPct.HasValue
        && m.CavalryAtkPct.HasValue && m.CavalryLethalityPct.HasValue
        && m.ArcherAtkPct.HasValue && m.ArcherLethalityPct.HasValue;

    // timeline: shared AcademyTimeline engine — SSR plan + controls seed
    private AcademyTimeline.Inputs _inputs = null!;
    private AcademyTimeline.Plan _plan = null!;
    private string _source = "custom";
}
