<div id="next-bear" class="card card--rounded next-bear-card">
    <div class="banner flex-between bear-banner">
        <div class="bear-date-block">
            <span class="bear-label">NEXT BEAR HUNT</span>
            <time class="bear-date" data-intl-time="date" datetime="@NextDate.ToString("yyyy-MM-dd")T00:00:00Z">@NextDate.ToString("dddd, MMMM d")</time>
        </div>
        <div class="bear-countdown">@((MarkupString)Countdown)</div>
    </div>
    <div class="bear-rosters">
        <TrapRosterSection Trap="1" TrapTime="@Cycle.Trap1Time" NextDate="@NextDate" Prefs="@Trap1Prefs" Members="@Members" IsAdmin="@IsAdmin" />
    </div>
    <div class="bear-rosters">
        <TrapRosterSection Trap="2" TrapTime="@Cycle.Trap2Time" NextDate="@NextDate" Prefs="@Trap2Prefs" Members="@Members" IsAdmin="@IsAdmin" />
    </div>
    @* action="#" prevents StaticHtmlRenderer from calling uninitialized NavigationManager when rendered server-side for SSE patches *@
    <form class="bear-signup" data-on:submit="@@post('/api/preferences/upsert', {contentType: 'form'})" action="#">
        <div class="signup-row">
            <label>Trap<select name="selectedTrap">
                <option value="either" selected="@(MyPref?.SelectedTrap == null || MyPref?.SelectedTrap == "either")">Either trap</option>
                <option value="1" selected="@(MyPref?.SelectedTrap == "1")">Trap 1</option>
                <option value="2" selected="@(MyPref?.SelectedTrap == "2")">Trap 2</option>
            </select></label>
            <label>Notes<input type="text" name="notes" value="@(MyPref?.Notes ?? "")" placeholder="Notes (optional)" /></label>
            <button type="submit" class="btn--primary">@ButtonText</button>
            @if (MyPref != null)
            {
                <button data-on:click="@@post('/api/preferences/remove')" class="btn-remove" type="button">Remove</button>
            }
        </div>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public DateTime NextDate { get; set; }
    [Parameter, EditorRequired] public Cycle Cycle { get; set; } = null!;
    [Parameter, EditorRequired] public List<Preference> Prefs { get; set; } = null!;
    [Parameter, EditorRequired] public Dictionary<string, Member> Members { get; set; } = null!;
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public DateTime Now { get; set; }
    [Parameter] public string? Username { get; set; }

    List<Preference> Trap1Prefs => Prefs.Where(p => p.SelectedTrap is "1" or "either").ToList();
    List<Preference> Trap2Prefs => Prefs.Where(p => p.SelectedTrap is "2" or "either").ToList();
    Preference? MyPref => Prefs.FirstOrDefault(p => string.Equals(p.Username, Username, StringComparison.OrdinalIgnoreCase));
    string ButtonText => MyPref != null ? "Update" : "Sign Up";

    string Countdown
    {
        get
        {
            var target = NextDate.Date.Add(Cycle.Trap1Time.ToTimeSpan());
            var remaining = target - Now;
            if (remaining.TotalSeconds <= 0)
            {
                target = NextDate.Date.Add(Cycle.Trap2Time.ToTimeSpan());
                remaining = target - Now;
                if (remaining.TotalSeconds <= 0)
                    return "<span class=\"countdown-live\">LIVE</span>";
                if (remaining.TotalHours < 1)
                    return $"<span class=\"countdown-label\">T2 in</span> {remaining.Minutes}m";
                return $"<span class=\"countdown-label\">T2 in</span> {remaining.Hours}h {remaining.Minutes}m";
            }
            if (remaining.TotalHours < 1)
                return $"{remaining.Minutes}m <span class=\"countdown-label\">remaining</span>";
            return $"{remaining.Hours}h {remaining.Minutes}m <span class=\"countdown-label\">remaining</span>";
        }
    }
}
