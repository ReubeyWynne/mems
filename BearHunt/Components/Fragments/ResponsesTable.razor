<div id="responses">
    @if (!Prefs.Any())
    {
        <p>No responses yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th scope="col">Member</th><th scope="col">Trap</th><th scope="col">Notes</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Prefs)
                {
                    <tr>
                        <td>@E(p.Username)</td>
                        <td>@E(p.SelectedTrap)</td>
                        <td>@E(p.Notes)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<Preference> Prefs { get; set; } = null!;
}
