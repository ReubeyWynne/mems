@page "/bear-hunt/admin"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IDataProtectionProvider DataProtectionProvider
@inject IHttpContextAccessor HttpContextAccessor

@if (_isAuthenticated)
{
    <h1>Admin</h1>

    <form data-on:submit="@@post('/api/cycles/upsert', {contentType: 'form'})">
        <fieldset>
            <legend>Cycle Configuration</legend>
            <div class="form-group">
                <label>Date</label>
                <input type="date" name="date" value="@_cycle?.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Trap 1 Time</label>
                    <input type="time" name="trap1Time" value="@_cycle?.Trap1Time.ToString("HH:mm")" />
                </div>
                <div class="form-group">
                    <label>Trap 2 Time</label>
                    <input type="time" name="trap2Time" value="@_cycle?.Trap2Time.ToString("HH:mm")" />
                </div>
            </div>
            <button type="submit">Save Configuration</button>
        </fieldset>
    </form>

    <fieldset>
        <legend>Homepage Secrets</legend>
        <form data-on:submit="@@post('/api/jokes', {contentType: 'form'})">
            <div class="form-row">
                <div class="form-group" style="flex:1">
                    <input type="text" name="text" placeholder="New secret string..." style="width:100%" />
                </div>
                <div class="form-group">
                    <button type="submit">Add</button>
                </div>
            </div>
        </form>
        <div id="joke-list"
             data-init="&#64;get('/api/jokes')">
            <p>Loading...</p>
        </div>
    </fieldset>


    <fieldset>
        <legend>Database</legend>
        <a href="/api/admin/export-db" class="btn-export">Download Backup</a>
    </fieldset>
    <div id="feedback"></div>

    <form method="post" action="/api/admin/logout" style="margin-top:2rem">
        <button type="submit">Logout</button>
    </form>
}
else
{
    <h1>Admin Login</h1>
    <form method="post" action="/api/admin/login">
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" autofocus />
        </div>
        <button type="submit">Login</button>
    </form>
    @if (_error is not null)
    {
        <div id="feedback" class="feedback feedback--error">@_error</div>
    }
}

@code {
    private bool _isAuthenticated;
    private string? _error;
    private Cycle? _cycle;

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext!;
        _isAuthenticated = CookieIsValid(ctx.Request);

        // Show error if redirected back from failed login
        if (ctx.Request.Query.TryGetValue("error", out var err))
        {
            _error = err;
        }

        if (_isAuthenticated)
        {
            _cycle = await Db.Cycles.FindAsync(1);
        }
    }

    private bool CookieIsValid(HttpRequest request)
    {
        if (!request.Cookies.TryGetValue("bh_admin", out var cookie))
            return false;
        try
        {
            var protector = DataProtectionProvider.CreateProtector("bh-admin-auth")
                .ToTimeLimitedDataProtector();
            protector.Unprotect(cookie);
            return true;
        }
        catch
        {
            return false;
        }
    }
}
